---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import { stories } from "@/data/content";

interface Props {
  reverse?: boolean;
}
const { reverse = false } = Astro.props;
// Duplica a lista para loop contínuo e infinito
const loop = [...stories, ...stories];
---

<div class="marquee relative w-full overflow-hidden py-2">
  <div
    class="marquee-track flex w-max gap-4"
    style={`animation: var(--animate-marquee${reverse ? "-slow" : ""}); ${reverse ? "animation-direction: reverse;" : ""}`}
  >
    {
      loop.map((src, i) => (
        <div class="w-[150px] shrink-0 overflow-hidden rounded-xl bg-white shadow-card sm:w-[190px]">
          <Image
            src={img(src)}
            alt="Depoimento de aluna no WhatsApp"
            width={190}
            height={338}
            loading="lazy"
            class="h-auto w-full object-cover"
            aria-hidden={i >= stories.length ? "true" : undefined}
          />
        </div>
      ))
    }
  </div>
  <!-- fades laterais -->
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-cream to-transparent"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-cream to-transparent"
  >
  </div>
</div>
