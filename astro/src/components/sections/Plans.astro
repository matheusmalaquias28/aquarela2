---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import { plans, checkout } from "@/data/content";
import Cta from "@/components/Cta.astro";
import WashEdge from "@/components/WashEdge.astro";

const { basic, complete, upsell } = plans;
---

<section class="relative overflow-hidden bg-white px-4 py-16 sm:px-6 sm:py-20">
  <WashEdge over="var(--color-green-deep)" />
  <div class="mx-auto max-w-6xl">
    <div class="text-center">
      <span
        class="inline-block rounded-full bg-rose/10 px-4 py-1.5 font-label text-xs font-bold uppercase tracking-wide text-rose"
        >{plans.pill}</span
      >
      <h2 class="mt-5 text-3xl text-ink sm:text-4xl">{plans.title}</h2>
    </div>

    <div class="mt-12 grid items-start gap-8 lg:grid-cols-2">
      <!-- ── Plano Básico ── -->
      <div class="rounded-3xl bg-paper p-6 shadow-card ring-1 ring-black/5 sm:p-8">
        <div class="mx-auto mb-5 w-40">
          <Image
            src={img(basic.image)}
            alt={basic.imageAlt}
            width={440}
            height={440}
            loading="lazy"
            class="h-auto w-full"
          />
        </div>
        <h3 class="text-center font-display text-2xl text-ink">{basic.name}</h3>

        <p class="mt-5 font-label text-xs font-bold uppercase tracking-wide text-ink-mute">
          {basic.receiveLabel}
        </p>
        <ul class="mt-3 grid gap-2">
          {
            basic.features.map((f) => (
              <li class="flex items-start gap-2.5 font-body text-sm text-ink-soft">
                <svg class="mt-0.5 w-4 shrink-0" viewBox="0 0 18 13" fill="none" aria-hidden="true">
                  <path d="M17 1L6 12L1 7" stroke="#3a7d44" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {f}
              </li>
            ))
          }
          {
            basic.crossed.map((f) => (
              <li class="flex items-start gap-2.5 font-body text-sm text-ink-mute/60 line-through">
                <svg class="mt-0.5 w-4 shrink-0" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 1L13 13M13 1L1 13" stroke="#e53935" stroke-width="2" stroke-linecap="round"/>
                </svg>
                {f}
              </li>
            ))
          }
        </ul>

        <div class="mt-6 text-center">
          <p class="font-body text-sm text-ink-mute">
            de <s>{basic.oldPrice}</s> por
          </p>
          <p class="font-display text-4xl text-green-deep">{basic.price}</p>
          <p class="mt-1 font-body text-sm text-ink-soft">{basic.installments}</p>
          <p class="mt-1 font-label text-xs font-semibold text-green">{basic.savings}</p>
        </div>

        <div class="mt-6">
          <Cta href={checkout.basic} label={basic.cta} variant="light" pulse={false} />
        </div>

        <!-- upsell -->
        <div class="mt-6 rounded-xl bg-rose/5 p-4 text-center">
          <p class="font-label text-sm font-bold uppercase text-rose">{upsell.alert}</p>
          <p class="mt-1 font-body text-sm text-ink-soft">
            {upsell.body} <strong class="text-green-deep">{upsell.highlight}</strong>
          </p>
        </div>
      </div>

      <!-- ── Plano Completo (destaque) ── -->
      <div class="relative rounded-3xl bg-green-deep p-6 text-white shadow-soft ring-2 ring-green sm:p-8">
        <span
          class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-ochre px-4 py-1.5 font-label text-xs font-extrabold uppercase tracking-wide text-white shadow-lg"
          >{complete.ribbon}</span
        >

        <p class="mt-2 rounded-lg bg-rose px-4 py-2 text-center font-label text-xs font-bold uppercase tracking-wide">
          {complete.badge}
        </p>

        <div class="mx-auto my-5 w-44">
          <Image
            src={img(complete.image)}
            alt={complete.imageAlt}
            width={480}
            height={480}
            loading="lazy"
            class="h-auto w-full drop-shadow-xl"
          />
        </div>

        <div class="text-center">
          <h3 class="inline-block rounded-md bg-green px-4 py-1 font-display text-2xl text-white">
            {complete.name}
          </h3>
          <p class="mt-3 font-label text-sm font-bold uppercase tracking-wide text-green-soft">
            {complete.allBonuses}
          </p>
          <span class="mt-2 inline-block rounded-full bg-white/10 px-3 py-1 font-label text-xs font-bold uppercase tracking-wide">
            {complete.pill}
          </span>
        </div>

        <p class="mt-6 font-label text-xs font-bold uppercase tracking-wide text-green-soft">
          {complete.receiveLabel}
        </p>
        <ul class="mt-3 grid gap-2">
          {
            complete.features.map((f) => (
              <li class="flex items-start gap-2.5 font-body text-sm text-white/90">
                <svg class="mt-0.5 w-4 shrink-0" viewBox="0 0 18 13" fill="none" aria-hidden="true">
                  <path d="M17 1L6 12L1 7" stroke="#9dd090" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {f}
              </li>
            ))
          }
        </ul>

        <div class="mt-6 rounded-2xl bg-white/5 p-5 text-center ring-1 ring-white/10">
          <p class="font-body text-sm text-green-soft">
            de <s>{complete.oldPrice}</s> por
          </p>
          <p class="font-display text-5xl text-white">{complete.price}</p>
          <p class="mt-1 font-body text-sm text-green-soft">{complete.installments}</p>
          <p class="mt-1 font-label text-xs font-semibold text-green-soft">{complete.savings}</p>
        </div>

        <div class="mt-6">
          <Cta href={checkout.complete} label={complete.cta} variant="light" />
        </div>
      </div>
    </div>
  </div>
</section>
