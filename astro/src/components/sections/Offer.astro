---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import { offer, checkout } from "@/data/content";
import Cta from "@/components/Cta.astro";
import WashEdge from "@/components/WashEdge.astro";
---

<section class="paper-grain relative overflow-hidden bg-dark px-4 py-16 text-white sm:px-6 sm:py-20">
  <WashEdge over="var(--color-cream)" />
  <div
    class="pointer-events-none absolute left-1/2 top-0 size-80 -translate-x-1/2 rounded-full bg-green/20 blur-[100px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-5xl text-center">
    <span
      class="inline-block rounded-full bg-green px-4 py-1.5 font-label text-xs font-bold uppercase tracking-wide text-white"
      >{offer.pill}</span
    >
    <h2 class="mt-5 text-3xl text-white sm:text-4xl lg:text-5xl">{offer.title}</h2>
    <p class="mx-auto mt-3 max-w-2xl font-label text-sm uppercase tracking-wide text-white/60">
      {offer.subtitle}
    </p>
  </div>

  <div class="relative mx-auto mt-12 grid max-w-5xl items-center gap-10 lg:grid-cols-2">
    <!-- imagem -->
    <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div
        class="pointer-events-none absolute inset-0 scale-90 rounded-full bg-green/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <Image
        src={img(offer.image)}
        alt={offer.imageAlt}
        width={760}
        height={760}
        loading="lazy"
        class="relative h-auto w-full drop-shadow-2xl"
        sizes="(min-width: 1024px) 45vw, 85vw"
      />
    </div>

    <!-- features -->
    <div>
      <ul class="grid gap-2.5">
        {
          offer.features.map((f) => (
            <li class="flex items-start gap-3 rounded-lg bg-white/5 px-4 py-2.5">
              <svg class="mt-0.5 w-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="10" fill="#3a7d44" />
                <path d="M6 10.5l2.5 2.5L14 7" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="font-body text-sm text-white/90 sm:text-[15px]">{f}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-center font-display text-2xl text-green-soft lg:text-left">
        {offer.more}
      </p>

      <div class="mt-8">
        <Cta href={checkout.complete} label={offer.cta} variant="light" />
        <p class="mt-4 text-center font-label text-sm text-white/60">{offer.note}</p>
      </div>
    </div>
  </div>
</section>
