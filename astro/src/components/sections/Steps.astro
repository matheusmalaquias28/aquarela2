---
import { steps, checkout } from "@/data/content";
import Cta from "@/components/Cta.astro";
import WashEdge from "@/components/WashEdge.astro";
---

<section class="paper-grain relative overflow-hidden bg-green-deep px-4 py-16 text-white sm:px-6 sm:py-20">
  <WashEdge over="var(--color-cream)" flip />
  <div class="relative mx-auto max-w-5xl">
    <div class="text-center">
      <h2 class="text-3xl text-white sm:text-4xl">{steps.title}</h2>
      <p class="mt-2 font-label text-sm uppercase tracking-wide text-green-soft">
        {steps.subtitle}
      </p>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        steps.items.map((s, i) => (
          <li class="relative rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
            <div class="flex items-center gap-3">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-green-soft/15 text-2xl" aria-hidden="true">
                {s.icon}
              </span>
              <div>
                <span class="font-label text-xs font-bold uppercase tracking-wide text-green-soft">
                  Passo {i + 1}
                </span>
                <h3 class="font-display text-lg text-white">{s.title}</h3>
              </div>
            </div>
            <p class="mt-3 font-body text-sm text-white/85">{s.desc}</p>
            <ul class="mt-3 grid gap-1.5">
              {s.items.map((it) => (
                <li class="flex items-start gap-2 font-body text-sm text-green-soft">
                  <svg class="mt-0.5 w-3.5 shrink-0" viewBox="0 0 18 13" fill="none" aria-hidden="true">
                    <path d="M17 1L6 12L1 7" stroke="#9dd090" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {it}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="mx-auto mt-10 max-w-md">
      <Cta href={checkout.complete} label={steps.cta} variant="light" />
    </div>
  </div>
</section>
