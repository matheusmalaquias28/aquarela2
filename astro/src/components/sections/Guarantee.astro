---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import { guarantee } from "@/data/content";
import WashEdge from "@/components/WashEdge.astro";
---

<section class="paper-grain relative overflow-hidden bg-cerulean px-4 py-16 text-white sm:px-6 sm:py-20">
  <WashEdge over="var(--color-white)" flip />
  <div
    class="pointer-events-none absolute -right-16 top-10 size-72 rounded-full bg-white/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex max-w-4xl flex-col items-center gap-8 md:flex-row md:items-start">
    <div class="w-40 shrink-0 sm:w-48">
      <Image
        src={img(guarantee.seal)}
        alt={guarantee.sealAlt}
        width={280}
        height={280}
        loading="lazy"
        class="h-auto w-full drop-shadow-xl"
      />
    </div>

    <div class="text-center md:text-left">
      <h2 class="text-3xl text-white sm:text-4xl">{guarantee.title}</h2>
      <p class="mt-4 font-label text-sm font-bold uppercase tracking-wide text-white/80">
        {guarantee.intro}
      </p>
      <p class="mt-4 font-body text-base text-white/90">{guarantee.lead}</p>
      <ul class="mx-auto mt-3 grid max-w-md gap-2 text-left md:mx-0">
        {
          guarantee.bullets.map((b) => (
            <li class="flex items-start gap-2.5 font-body text-sm text-white/90">
              <svg class="mt-1.5 w-2 shrink-0" viewBox="0 0 8 8" aria-hidden="true">
                <circle cx="4" cy="4" r="4" fill="#fff" fill-opacity="0.6" />
              </svg>
              {b}
            </li>
          ))
        }
      </ul>
      <p class="mt-5 font-body text-base text-white/90">
        {guarantee.outro} <strong class="text-white">{guarantee.outroStrong}</strong>
      </p>

      <div class="mt-6 rounded-xl bg-white/10 p-4 ring-1 ring-white/15">
        <p class="font-label text-sm text-white/80">{guarantee.helpLabel}</p>
        <a
          href={`mailto:${guarantee.email}`}
          class="font-label text-sm font-bold text-white underline decoration-white/40 underline-offset-2"
          >{guarantee.email}</a
        >
      </div>
    </div>
  </div>
</section>
