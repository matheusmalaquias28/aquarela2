---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import { bonus } from "@/data/content";
import WashEdge from "@/components/WashEdge.astro";
---

<section class="paper-grain relative overflow-hidden bg-green-deep px-4 py-16 text-white sm:px-6 sm:py-20">
  <WashEdge over="var(--color-dark)" flip />
  <div
    class="pointer-events-none absolute -left-16 top-24 size-72 rounded-full bg-green-soft/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="text-center">
      <span
        class="inline-block rounded-full bg-rose px-4 py-1.5 font-label text-xs font-bold uppercase tracking-wide"
        >{bonus.pill}</span
      >
      <h2 class="mt-5 text-3xl text-white sm:text-4xl">{bonus.titleLines[0]}</h2>
      <p class="mt-2 font-display text-xl italic text-green-soft sm:text-2xl">
        {bonus.titleLines[1]}
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        bonus.items.map((b, i) => (
          <article class="flex flex-col overflow-hidden rounded-2xl bg-white text-ink shadow-soft">
            <div class="relative aspect-[4/3] overflow-hidden bg-paper">
              <Image
                src={img(b.src)}
                alt={`Bônus: ${b.title}`}
                width={640}
                height={480}
                loading="lazy"
                class="size-full object-cover"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
              />
              <span class="absolute left-3 top-3 rounded-full bg-green px-3 py-1 font-label text-[11px] font-bold uppercase tracking-wide text-white">
                Bônus {i + 1}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-display text-lg text-green-deep">{b.title}</h3>
              <p class="mt-2 flex-1 font-body text-sm text-ink-soft">{b.desc}</p>
              <div class="mt-4 flex items-center justify-between border-t border-black/5 pt-4">
                <span class="font-label text-xs uppercase tracking-wide text-ink-mute">
                  Valor <s class="text-rose">{b.price}</s>
                </span>
                <span class="font-label text-sm font-extrabold uppercase text-green">
                  Grátis
                </span>
              </div>
              <p class="mt-3 rounded-md bg-paper px-3 py-2 text-center font-label text-[11px] font-semibold uppercase tracking-wide text-ink-mute">
                {bonus.exclusiveNote}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
